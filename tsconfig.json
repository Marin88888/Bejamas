{
    "compilerOptions": {
      "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "types": ["@playwright/test"],
      "outDir": "dist"
    },
    "include": ["tests/**/*.ts", "pages/**/*.ts"]
  }
  